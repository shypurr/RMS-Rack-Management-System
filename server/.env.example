# Copy to .env and adjust for your MySQL instance
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rms
PORT=4000

# Managed hosts (Aiven, Railway, PlanetScale) require TLS; a local MySQL does
# not. Leave DB_SSL unset for localhost. With DB_SSL=true and no DB_CA it
# connects without verifying the certificate — paste the provider's CA cert
# into DB_CA for full verification.
# DB_SSL=true

# One-time escape hatch for a database built before organization scoping. The
# migration in src/schemaMigrations.js rebuilds the core tables into their
# current shape, and refuses while they hold rows because the old text rack code
# (R05-S02-B04) cannot be converted to the new numeric id. Set this to true ONLY
# when those rows are expendable: the next boot discards them, names every one in
# the log, and rebuilds. Remove the variable afterwards — the schema_migration
# ledger already stops it running twice, but leaving it set arms the same
# override for any future destructive migration.
# ALLOW_DESTRUCTIVE_MIGRATION=true
# DB_CA="-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----"

# ── Vastra login (mobile + OTP) ────────────────────────────────────────────
# Vastra is the identity provider — without these, /api/auth returns 502 and
# nobody can log in. No fallback URL is baked in on purpose.
# Use the base URL you were given; the friendly webstaging.vastraapp.com host
# 301s POSTs away and drops the path, so don't "correct" it to that domain.
VASTRA_API_BASE_URL=http://13.235.138.204:3000/api/v2
# Staging's api-key really is the literal "1" (verified: any other value gets
# "Invalid api-key"). Expect a different value for production.
VASTRA_API_KEY=1
VASTRA_API_TIMEOUT=10000
VASTRA_UDID=rms-backend
VASTRA_DEVICE_TYPE=android

# Read Flow A from the real Vastra source modules instead of the
# `source_transaction` stub table. All four modules come from one endpoint,
# GET /rack-manager/basic-details?moduleType=1..4 — set true once VASTRA_API_KEY
# is filled in above, since that endpoint needs a logged-in Vastra token.
USE_VASTRA_MODULES=false
# Same switch for the picklist's challan feed alone. Unset = follow the flag
# above. Set to false to pick against the sample challans from makeChallans.js
# while Add Item keeps reading live Vastra.
# USE_VASTRA_PICKLIST=false

# ── QR login (MQTT) ────────────────────────────────────────────────────────
# Vastra publishes the scan and approval events for a QR login onto a
# per-attempt topic; the server subscribes and waits. Same host as
# VASTRA_API_BASE_URL — one machine, the API on 3000 and the broker on 1884.
#
# This connection lives in the Node server, not the browser. Keep it that way:
# the page is served over HTTPS in production and an HTTPS page cannot open a
# ws:// socket, so a browser-side client would need a wss:// port that Vastra
# does not currently offer.
#
# No fallback URL, same as VASTRA_API_BASE_URL — unset means QR login is simply
# unavailable rather than dialling some other host.
#
# The connection URL exactly as Vastra supplied it:
MQTT_URL=tcp://13.235.138.204:1884

# ⚠ If the server logs `Invalid header flag bits, must be 0x0 for puback packet`
#   at boot, the line above is the reason and one of these two fixes it. Port
#   1884 is a WebSocket listener, so raw TCP gets an HTTP response back which
#   mqtt.js tries to parse as an MQTT packet. Vastra's `tcp://` is their naming
#   convention for "not TLS", not a description of the wire protocol.
#
#   Both of these are verified working against the live broker:
# MQTT_URL=ws://13.235.138.204:1884     # same port Vastra gave, correct scheme
# MQTT_URL=mqtt://13.235.138.204:1883   # raw TCP listener, SAME message bus
#                                       # (verified: publish on 1883 → received on 1884)

# Vastra's broker accepts anonymous connections today, so these stay empty.
# They exist so that locking it down later is a config change, not a code one.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONNECT_TIMEOUT=10000

# ── local testing only — uncomment to run with no Vastra access at all ──────
# Run `node devBroker.js` for a local broker, then drive the flow by hand with
# devPublishQr.js (plays Vastra's server) and devFakeVastra.js (plays their
# API). See the header comment in each file.
# MQTT_URL=mqtt://127.0.0.1:1883
# VASTRA_API_BASE_URL=http://127.0.0.1:19999/api/v2

# How long a displayed QR stays valid before the portal asks for a new one.
QR_LOGIN_TTL_MS=120000
# Used when Vastra's MQTT payload omits country_code (their reference handler
# falls back to a configured default the same way).
VASTRA_DEFAULT_COUNTRY_CODE=+91
