# Copy to .env and adjust for your MySQL instance
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rms
PORT=4000

# Managed hosts (Aiven, Railway, PlanetScale) require TLS; a local MySQL does
# not. Leave DB_SSL unset for localhost. With DB_SSL=true and no DB_CA it
# connects without verifying the certificate — paste the provider's CA cert
# into DB_CA for full verification.
# DB_SSL=true
# DB_CA="-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----"

# ── Vastra login (mobile + OTP) ────────────────────────────────────────────
# Vastra is the identity provider — without these, /api/auth returns 502 and
# nobody can log in. No fallback URL is baked in on purpose.
# Use the base URL you were given; the friendly webstaging.vastraapp.com host
# 301s POSTs away and drops the path, so don't "correct" it to that domain.
VASTRA_API_BASE_URL=http://13.235.138.204:3000/api/v2
# Staging's api-key really is the literal "1" (verified: any other value gets
# "Invalid api-key"). Expect a different value for production.
VASTRA_API_KEY=1
VASTRA_API_TIMEOUT=10000
VASTRA_UDID=rms-backend
VASTRA_DEVICE_TYPE=android

# Read Flow A from the real Vastra source modules instead of the
# `source_transaction` stub table. All four modules come from one endpoint,
# GET /rack-manager/basic-details?moduleType=1..4 — set true once VASTRA_API_KEY
# is filled in above, since that endpoint needs a logged-in Vastra token.
USE_VASTRA_MODULES=false
# Same switch for the picklist's challan feed alone. Unset = follow the flag
# above. Set to false to pick against the sample challans from makeChallans.js
# while Add Item keeps reading live Vastra.
# USE_VASTRA_PICKLIST=false
